{
  "name": "@david/console-static-text",
  "exports": "./mod.ts",
  "tasks": {
    "build": "deno run -A @deno/wasmbuild --inline --out ./lib",
    "dnt": "deno run -A ./scripts/buildNpm.ts"
  },
  "publish": {
    "exclude": [
      "scripts"
    ]
  },
  "exclude": [
    "npm/",
    "target"
  ],
  "lint": {
    "rules": {
      "include": ["no-console"],
      "exclude": ["no-process-global"]
    }
  },
  "imports": {
    "@david/publish-on-tag": "jsr:@david/publish-on-tag@^0.2.0",
    "@deno/dnt": "jsr:@deno/dnt@^0.42.3",
    "@deno/wasmbuild": "jsr:@deno/wasmbuild@^0.22.0",
    "@std/assert": "jsr:@std/assert@^1.0.13",
    "@std/async": "jsr:@std/async@^1.0.13"
  }
}
